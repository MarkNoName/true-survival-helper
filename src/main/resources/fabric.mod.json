{
	"schemaVersion": 1,
	"id": "tsh",
	"version": "${version}",
	"provides": [
		"levelz",
		"libz"
	],
	"name": "True Survival Helper",
	"description": "Native compatibility layer for the True Survival modpack, fixing interactions between mods that don't work correctly together out of the box. Includes modified versions of LevelZ and LibZ by Globox_Z.",
	"authors": [
		"Mark"
	],
	"contributors": [
		"Globox_Z"
	],
	"license": "GPL-3.0-only",
	"icon": "assets/tsh/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.libz.LibzMain",
			"net.levelz.LevelzMain",
			"net.truesurvivalhelper.TrueSurvivalHelper"
		],
		"client": [
			"net.libz.LibzClient",
			"net.levelz.LevelzClient",
			"net.truesurvivalhelper.TrueSurvivalHelperClient"
		]
	},
	"mixins": [
		{
			"config": "tsh-libz.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-levelz.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-client.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-toughasnails.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-biomemakeover.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-vanillabackport.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-spartankick.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-bloodmoon.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-bloodmoon-client.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-guibackport.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-guibackport-sodium.mixins.json",
			"environment": "client"
		},
		{
			"config": "tsh-loot.mixins.json",
			"environment": "*"
		},
		{
			"config": "tsh-sleeprework.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"recommends": {
		"toughasnails": "*",
		"biomemakeover": "*",
		"vanillabackport": "*",
		"spartan-kick": "*",
		"sodium": "*",
		"sleeprework": "*",
		"snowrealmagic": "*",
		"lambdynlights": "*"
	},
	"breaks": {
		"true_survival_level_z": "*"
	}
}
